# Copy this file to .env and fill in your values.
# Get a free Groq key at https://console.groq.com

# Your Groq API key (required)
GROQ_API_KEY=gsk_your_key_here

# Postgres credentials for your LOCAL Docker container.
# These are NOT real secrets — pick anything you like.
# The database only exists inside Docker on your machine.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=pick_anything_you_like
POSTGRES_DB=cochee